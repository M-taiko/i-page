# EMERGENCY STOPGAP ONLY. The real fix is pointing the domain's Document
# Root at the public/ folder — once that's done this file becomes
# unreachable anyway and can be deleted. Until then, this blocks direct
# web access to dotfiles (.env, .git, etc.) when the project root is
# (incorrectly) served directly by the web server.

<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
